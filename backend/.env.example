#  platform/backend/.env
#  COMPLETE REKSOLINDO BACKEND - PRODUCTION ENVIRONMENT WITH SSE SUPPORT
# =============================================================================

# Application Settings
APP_ENV=production
APP_PORT=4072
APP_HOST=0.0.0.0
NODE_ENV=production

# Security
REKSOLINDO_ENCRYPTION_KEY=1566da56f61361c36dab9493b1f138d4

# Database Configuration
DB_DRIVER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=reksolindo_platform
DB_USER=postgres
DB_PASSWORD=
DB_SSL_MODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
DB_CONN_MAX_LIFETIME=15m

# =============================================================================
#  ENHANCED JWT SETTINGS FOR AUTOMATIC TOKEN REFRESH
# =============================================================================

#  CRITICAL: Strong JWT Secret Key (CHANGE IN PRODUCTION!)
JWT_SECRET=mAiDfbm0pAcpU0wMB/TT/fcU5P+GvmGE+N9FI68Iv40=

#  OPTIMIZED: Access Token Settings (Short duration with auto-refresh)
JWT_ACCESS_TOKEN_DURATION=30m               # 30 minutes (optimal for auto-refresh)
JWT_ACCESS_TOKEN_DURATION_MINUTES=30        # Backward compatibility

#  OPTIMIZED: Refresh Token Settings (Longer duration for better UX)
JWT_REFRESH_TOKEN_DURATION=72h              # 3 days (was 168h/7days, reduced for security)
JWT_REFRESH_TOKEN_DURATION_HOURS=72         # Backward compatibility

#  NEW: Token Refresh Behavior Configuration
JWT_REFRESH_BEFORE_EXPIRY=15m               # Allow refresh 15 minutes before expiry
JWT_REFRESH_GRACE_PERIOD=2m                 # Grace period for processing refresh requests
JWT_PROACTIVE_REFRESH_ENABLED=true          # Enable proactive refresh on frontend
JWT_REFRESH_SLIDING_WINDOW=true             # Enable sliding window refresh

#  NEW: Token Security Enhancements
JWT_BLACKLIST_ENABLED=true                  # Enable token blacklisting
JWT_BLACKLIST_GRACE_PERIOD=60s              # Grace period for blacklisted tokens
JWT_REQUIRE_FRESH_FOR_SENSITIVE=true        # Require fresh tokens for sensitive operations
JWT_MAX_REFRESH_PER_HOUR=10                 # Max refresh attempts per user per hour

#  NEW: JWT Claims Configuration
JWT_ISSUER=reksolindo-platform              # Token issuer
JWT_AUDIENCE=reksolindo-users                # Token audience  
JWT_ALGORITHM=HS256                          # Signing algorithm
JWT_LEEWAY=60s                              # Clock skew tolerance
JWT_NOT_BEFORE_TOLERANCE=60s                # Not-before tolerance

# =============================================================================
#  REDIS CONFIGURATION FOR TOKEN BLACKLISTING AND SSE
# =============================================================================

# Redis Connection
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=                   # Empty for development, set in production
REDIS_DB=3                                  # Main Redis database
REDIS_TOKEN_BLACKLIST_DB=4                  # Separate DB for token blacklist
REDIS_SESSION_DB=5                          # Separate DB for sessions
REDIS_SSE_DB=6                             # Separate DB for SSE connections

# Redis Pool Configuration
REDIS_MAX_IDLE=10
REDIS_MAX_ACTIVE=100
REDIS_CONNECT_TIMEOUT=30s
REDIS_READ_TIMEOUT=30s
REDIS_WRITE_TIMEOUT=30s

# Token Blacklist Settings
TOKEN_BLACKLIST_CLEANUP_INTERVAL=60m        # Clean up expired blacklisted tokens every hour
TOKEN_BLACKLIST_MAX_SIZE=100000             # Maximum blacklisted tokens to store
TOKEN_BLACKLIST_PERSISTENT=true             # Persist blacklist across restarts

# =============================================================================
#  SSE (SERVER-SENT EVENTS) CONFIGURATION
# =============================================================================

# SSE Settings
SSE_ENABLED=true                            # Enable SSE support
SSE_PATH=/sse                               # SSE endpoint path
SSE_HEARTBEAT_INTERVAL=30s                  # Heartbeat interval
SSE_CONNECTION_TIMEOUT=300s                 # Connection timeout (5 minutes)
SSE_MAX_CONNECTIONS_PER_USER=5              # Max connections per user
SSE_BUFFER_SIZE=1024                        # Message buffer size
SSE_RETRY_INTERVAL=3s                       # Client retry interval

# SSE Authentication
SSE_REQUIRE_AUTH=true                       # Require authentication for SSE
SSE_TOKEN_VALIDATION=true                   # Validate JWT tokens for SSE
SSE_CORS_ENABLED=true                       # Enable CORS for SSE

# SSE Performance
SSE_COMPRESSION_ENABLED=true                # Enable gzip compression
SSE_KEEP_ALIVE_ENABLED=true                 # Enable keep-alive
SSE_MAX_MESSAGE_SIZE=4096                   # Max message size in bytes

# =============================================================================
#  SESSION MANAGEMENT CONFIGURATION
# =============================================================================

# Session Settings
SESSION_SECRET=Vjx1tjg6oZrkKb7iSc0Y91UN8QF1tRL3T3CdHXRTBoM=
SESSION_TIMEOUT=3600                        # Session timeout in seconds (1 hour)
SESSION_MAX_CONCURRENT=5                    # Max concurrent sessions per user
SESSION_VALIDATION_INTERVAL=300             # Validate sessions every 5 minutes
SESSION_CROSS_TAB_SYNC=true                 # Enable cross-tab session sync

# =============================================================================
#  SECURITY ENHANCEMENTS FOR TOKEN REFRESH AND SSE
# =============================================================================

# Rate Limiting for Token Refresh
REFRESH_RATE_LIMIT_REQUESTS=5               # Max refresh requests per minute per user
REFRESH_RATE_LIMIT_WINDOW=60s               # Rate limit window
REFRESH_RATE_LIMIT_BURST=3                  # Rate limit burst allowance

# Token Validation Security
TOKEN_VALIDATION_STRICT=true                # Strict token validation
TOKEN_REQUIRE_EXPIRY=true                   # Require expiry claim
TOKEN_REQUIRE_NOT_BEFORE=true               # Require not-before claim
TOKEN_REQUIRE_ISSUED_AT=true                # Require issued-at claim

# Cross-Origin Settings (Required for secure token refresh and SSE)
CORS_ALLOW_CREDENTIALS=true                 # Required for cookie-based auth
CORS_MAX_AGE=86400                          # CORS preflight cache duration (24 hours)

# Security Headers
SECURITY_HEADERS_ENABLED=true
HSTS_ENABLED=true
HSTS_MAX_AGE=31536000                       # 1 year
XSS_PROTECTION=true
CONTENT_TYPE_NOSNIFF=true
FRAME_OPTIONS=DENY

# =============================================================================
#  ENHANCED CORS CONFIGURATION - COMPLETE FIX FOR SSE
# =============================================================================
# CORS Settings - MUST include ALL frontend domains and SSE domain
CORS_ALLOWED_ORIGINS=https://reksolindo.opuschamber.com,https://breksolindo.opuschamber.com,https://wssreksolindo.opuschamber.com,http://localhost:4071,http://localhost:5173,http://localhost:3000
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH,HEAD
# 🔧 COMPLETE FIX: Added ALL missing headers that frontend sends + SSE headers
CORS_ALLOWED_HEADERS=Content-Type,Content-Length,Accept-Encoding,X-CSRF-Token,Authorization,accept,origin,Cache-Control,X-Requested-With,X-Development-Mode,X-Mock-Token,X-Request-ID,X-Tenant-ID,X-Tenant-Subdomain,X-Client-Version,User-Agent,Referer,Accept,Accept-Language,Accept-Encoding,Connection,Host,Last-Event-ID
CORS_EXPOSED_HEADERS=X-Request-ID,X-Total-Count,Content-Type,Cache-Control
# =============================================================================

# =============================================================================
#  AUDIT LOGGING FOR TOKEN OPERATIONS AND SSE
# =============================================================================

# Audit Logging
AUDIT_LOGGING_ENABLED=true
AUDIT_LOG_TOKEN_REFRESH=true                # Log token refresh events
AUDIT_LOG_TOKEN_BLACKLIST=true              # Log token blacklisting
AUDIT_LOG_SESSION_EVENTS=true               # Log session events
AUDIT_LOG_SENSITIVE_OPS=true                # Log sensitive operations
AUDIT_LOG_SSE_CONNECTIONS=true              # Log SSE connection events
AUDIT_LOG_RETENTION_DAYS=90                 # Audit log retention period

# =============================================================================
#  PERFORMANCE OPTIMIZATION
# =============================================================================

# Token Caching
TOKEN_CACHE_ENABLED=true
TOKEN_CACHE_TTL=300                         # Token cache TTL in seconds (5 minutes)
TOKEN_CACHE_MAX_SIZE=10000                  # Maximum cached tokens

# Database Performance
DB_QUERY_TIMEOUT=30s
DB_SLOW_QUERY_THRESHOLD=1s
DB_PREPARED_STATEMENTS=true

# Memory Management
GO_MAX_PROCS=0                              # Use all available CPU cores
GO_GC_PERCENT=100                           # Garbage collection percentage

# =============================================================================
#  MONITORING AND HEALTH CHECKS
# =============================================================================

# Health Checks
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_TOKEN_VALIDATION=true          # Include token validation in health checks
HEALTH_CHECK_REDIS_CONNECTION=true          # Include Redis in health checks
HEALTH_CHECK_DATABASE_CONNECTION=true       # Include database in health checks
HEALTH_CHECK_BLACKLIST_SERVICE=true         # Include blacklist service in health checks
HEALTH_CHECK_SSE_SERVICE=true               # Include SSE service in health checks

# Metrics and Monitoring
ENABLE_METRICS=true
METRICS_PATH=/metrics
METRICS_PORT=9090

# Token-specific Metrics
TRACK_TOKEN_REFRESH_METRICS=true
TRACK_TOKEN_BLACKLIST_METRICS=true
TRACK_SESSION_METRICS=true
TRACK_AUTH_FAILURE_METRICS=true
TRACK_SSE_METRICS=true                      # Track SSE connection metrics

# =============================================================================
#  DEVELOPMENT & DEBUG SETTINGS (PRODUCTION: DISABLED)
# =============================================================================
# Development mode flags - DISABLED in production
DEBUG_AUTH=false
DEBUG_CORS=false
DEBUG_MIDDLEWARE=false
DEBUG_TOKEN_REFRESH=false                   # Debug token refresh operations
DEV_AUTH_BYPASS=false
ENABLE_MOCK_AUTH=false

# Production logging
LOG_LEVEL=info
GIN_MODE=release

# Logging Configuration
REKSOLINDO_LOG_LEVEL=info
REKSOLINDO_LOG_FORMAT=json
REKSOLINDO_LOG_COLORS=false
REKSOLINDO_LOG_CALLER=false
REKSOLINDO_LOG_FILE=true
REKSOLINDO_LOG_FILE_PATH=./logs/backend.log
REKSOLINDO_LOG_STDOUT=true
REKSOLINDO_LOG_REQUEST_BODY=false
REKSOLINDO_LOG_RESPONSE_BODY=false

# =============================================================================
#  CACHE SETTINGS
# =============================================================================
CACHE_ENABLED=true
CACHE_TYPE=redis                            # Use Redis for caching
CACHE_EXPIRATION=15m

# =============================================================================
#  RATE LIMITING
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_DURATION=1m

# Specific rate limits for auth operations
AUTH_RATE_LIMIT_REQUESTS=10                 # Login attempts per minute
AUTH_RATE_LIMIT_DURATION=1m
REFRESH_RATE_LIMIT_REQUESTS=5               # Token refresh per minute

# SSE Rate Limiting
SSE_RATE_LIMIT_ENABLED=true
SSE_RATE_LIMIT_CONNECTIONS=10               # Max SSE connections per minute per IP
SSE_RATE_LIMIT_MESSAGES=100                 # Max SSE messages per minute per user

# =============================================================================
#  EMAIL SETTINGS
# =============================================================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=no-reply@reksolindo.com
SMTP_FROM_NAME=Reksolindo Platform

# =============================================================================
#  DOMAIN CONFIGURATION
# =============================================================================
# Primary domain configuration
PRIMARY_DOMAIN=breksolindo.opuschamber.com
FRONTEND_DOMAIN=reksolindo.opuschamber.com
API_DOMAIN=breksolindo.opuschamber.com
SSE_DOMAIN=wssreksolindo.opuschamber.com

# Multi-tenant configuration
TENANT_ENABLED=true
DEFAULT_TENANT=reksolindo

# =============================================================================
#  SWAGGER/API DOCUMENTATION
# =============================================================================
SWAGGER_HOST=breksolindo.opuschamber.com
SWAGGER_SCHEMES=https,http
API_BASE_PATH=/api/v1

# =============================================================================
#  FILE UPLOAD SETTINGS
# =============================================================================
MAX_UPLOAD_SIZE=10485760
ALLOWED_FILE_TYPES=image/*,application/pdf,text/*,.xlsx,.docx
UPLOAD_PATH=./storage/uploads

# =============================================================================
#  WEBSOCKET CONFIGURATION (DEPRECATED - NOW USING SSE)
# =============================================================================
# WebSocket support disabled in favor of SSE
WEBSOCKET_ENABLED=false
WEBSOCKET_PATH=/ws
WEBSOCKET_ORIGINS=https://reksolindo.opuschamber.com,https://breksolindo.opuschamber.com,https://wssreksolindo.opuschamber.com,http://localhost:4071

# =============================================================================
#  FEATURE FLAGS FOR TOKEN REFRESH AND SSE
# =============================================================================
FEATURE_AUTOMATIC_TOKEN_REFRESH=true        # Enable automatic token refresh
FEATURE_TOKEN_BLACKLISTING=true             # Enable token blacklisting
FEATURE_SESSION_MANAGEMENT=true             # Enable session management
FEATURE_CROSS_TAB_SYNC=true                 # Enable cross-tab synchronization
FEATURE_PROACTIVE_REFRESH=true              # Enable proactive token refresh
FEATURE_AUDIT_LOGGING=true                  # Enable audit logging
FEATURE_PERFORMANCE_MONITORING=true         # Enable performance monitoring
FEATURE_SSE_ENABLED=true                    # Enable SSE support
FEATURE_SSE_AUTHENTICATION=true             # Enable SSE authentication
FEATURE_SSE_COMPRESSION=true                # Enable SSE compression

SESSION_MANAGEMENT_ENABLED=true
TOKEN_BLACKLIST_ENABLED=true
HYBRID_AUTH_ENABLED=true
SSE_ENABLED=true